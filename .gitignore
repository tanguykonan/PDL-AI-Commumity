# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs
debug/*.log
*.log

# Runtime Data & Temporary Files (RAM/ROM)
app/cluster/ram/temp/*
!app/cluster/ram/temp/.gitkeep
app/cluster/rom/datas/*.backup_*
app/cluster/rom/servers/log/*.jsonl
!app/cluster/rom/servers/log/.gitkeep
app/cluster/rom/servers/thread/*.json
!app/cluster/rom/servers/thread/.gitkeep
app/cluster/rom/users/*.json
!app/cluster/rom/users/.gitkeep

# Testing & Local Scratch
testing/
test.py
tests/
scratch/